#include <behaviors/rgbled_widget.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        Escape {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        // Windows用入力切り替え：Alt + Grave (~)

        ime_tog: ime_toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LALT>;
        };

        // macOS用入力切り替え：Ctrl + Space

        mac_ime: mac_ime_toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp SPACE>,
                <&macro_release>,
                <&kp LCTRL>;
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        // 

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Mac-Default_Layer {
            display-name = "Mac-Default_Layer";
            bindings = <
&kp Q             &kp W         &kp E         &kp R           &kp T                          &kp Y          &kp U    &lt 7 I    &kp O    &kp P
&kp A             &kp S         &kp D         &kp F           &kp G                          &kp H          &kp J    &kp K      &kp L    &kp SEMICOLON
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V           &kp B        &kp ESC           &kp N          &kp M    &kp COMMA  &kp DOT  &kp SLASH
&kp LCTRL         &kp LEFT_ALT  &kp LEFT_GUI  &lt 4 CAPSLOCK  &lt 2 SPACE  &lt 6 LANGUAGE_2  &kp BACKSPACE  &kp TAB  &kp ENTER  &mo 8    &kp RIGHT_SHIFT
            >;
        };

        Win-Default_Layer {
            display-name = "Win-Default_Layer";
            bindings = <
&kp Q             &kp W         &kp E         &kp R       &kp T                          &kp Y          &kp U    &lt 7 I    &kp O    &kp P
&kp A             &kp S         &kp D         &kp F       &kp G                          &kp H          &kp J    &kp K      &kp L    &kp SEMI
&mt LEFT_SHIFT Z  &kp X         &kp C         &kp V       &kp B        &kp ESCAPE        &kp N          &kp M    &kp COMMA  &kp DOT  &kp SLASH
&kp LCTRL         &kp LEFT_ALT  &kp LEFT_GUI  &lt 5 CAPS  &lt 3 SPACE  &lt 6 LANGUAGE_2  &kp BACKSPACE  &kp TAB  &kp ENTER  &mo 8    &kp RIGHT_SHIFT
            >;
        };

        Mac-Function_Layer {
            display-name = "Mac-Function_Layer";
            bindings = <
&kp F1            &kp F2             &kp F3                &kp F4        &kp F5                 &kp F6        &kp F7        &kp F8        &kp F9                &kp F10
&kp NUMBER_1      &kp NUMBER_2       &kp NUMBER_3          &kp NUMBER_4  &kp NUMBER_5           &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9          &kp NUMBER_0
&kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp NON_US_BACKSLASH  &kp GRAVE     &kp MINUS     &kp ESC  &kp EQUAL     &kp SQT       &kp F11       &kp F12               &kp F13
&trans            &trans             &trans                &trans        &trans        &trans   &trans        &kp TAB       &trans        &kp NON_US_BACKSLASH  &kp RIGHT_SHIFT
            >;
        };

        Win-Function_Layer {
            display-name = "Win-Function_Layer";
            bindings = <
&kp F1            &kp F2             &kp F3                &kp F4        &kp F5              &kp F6        &kp F7   &kp F8   &kp F9                &kp F10
&kp NUMBER_1      &kp NUMBER_2       &kp NUMBER_3          &kp NUMBER_4  &kp N5              &kp NUMBER_6  &kp N7   &kp N8   &kp N9                &kp N0
&kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp NON_US_BACKSLASH  &kp GRAVE     &kp MINUS  &kp ESC  &kp EQUAL     &kp SQT  &kp F11  &kp F12               &kp F13
&trans            &trans             &trans                &trans        &trans     &trans   &trans        &kp TAB  &trans   &kp NON_US_BACKSLASH  &kp RIGHT_SHIFT
            >;
        };

        Mac-Common_Layer {
            display-name = "Mac-Common_Layer";
            bindings = <
&kp ESC    &trans        &kp C_BRIGHTNESS_DEC  &kp LG(UP_ARROW)    &kp C_BRI_UP                 &kp LC(LEFT)     &kp LG(LEFT_ARROW)  &mkp MB3        &kp LG(RIGHT_ARROW)  &kp LC(RIGHT)
&kp TAB    &kp LEFT_GUI  &kp LS(TAB)           &kp LG(LEFT_ARROW)  &kp LG(RIGHT_ARROW)          &kp LG(TAB)      &mkp MB1            &kp UP_ARROW    &mkp MB2             &kp PAGE_UP
&kp LSHFT  &kp C_MUTE    &kp C_VOLUME_DOWN     &kp LG(DOWN)        &kp C_VOLUME_UP      &trans  &kp LS(LG(TAB))  &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW      &kp PAGE_DOWN
&kp LCTRL  &trans        &trans                &trans              &trans               &trans  &trans           &kp LG(T)           &trans          &trans               &kp END
            >;
        };

        Win-Common_Layer {
            display-name = "Win-Common_Layer";
            bindings = <
&kp ESC    &trans        &kp C_BRIGHTNESS_DEC  &kp LG(UP_ARROW)    &kp C_BRIGHTNESS_INC          &kp LC(W)          &kp LA(LEFT_ARROW)  &mkp MB3        &kp LA(RIGHT_ARROW)  &kp HOME
&kp TAB    &kp LEFT_GUI  &kp LS(TAB)           &kp LG(LEFT_ARROW)  &kp LG(RIGHT_ARROW)           &kp LC(PAGE_UP)    &mkp MB1            &kp UP_ARROW    &mkp MB2             &kp PAGE_UP
&kp LSHFT  &kp C_MUTE    &kp C_VOL_DN          &kp LG(DOWN_ARROW)  &kp C_VOLUME_UP       &trans  &kp LC(PAGE_DOWN)  &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT_ARROW      &kp PAGE_DOWN
&kp LCTRL  &trans        &trans                &trans              &trans                &trans  &trans             &kp LC(T)           &trans          &trans               &kp END
            >;
        };

        Num_Layer {
            bindings = <
&kp F1   &kp F2   &kp F3  &kp F4  &kp F5           &kp PLUS   &kp MINUS   &kp N7    &kp N8         &kp N9
&kp F6   &kp F7   &kp F8  &kp F9  &kp F10          &kp ASTRK  &kp SLASH   &kp N4    &kp N5         &kp N6
&kp F11  &kp F12  &trans  &trans  &trans   &trans  &kp EQUAL  &kp PERIOD  &kp N1    &kp N2         &kp N3
&trans   &trans   &trans  &trans  &trans   &trans  &kp ENTER  &kp DOLLAR  &kp BSPC  &kp AMPERSAND  &kp N0
            >;
        };

        V_Scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        Settings {
            display-name = "Settings";
            bindings = <
&trans  &trans  &trans  &trans  &trans         &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans         &trans        &trans          &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &to 0  &trans        &trans          &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &to 1  &sys_reset    &studio_unlock  &bootloader   &trans        &bt BT_CLR_ALL
            >;
        };

        AML {
            display-name = "AML";
            bindings = <
&trans  &trans  &trans  &trans  &trans          &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans          &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans
            >;
        };
    };
};
